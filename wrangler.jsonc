{
  "name": "mosaic-player",
  "compatibility_date": "2026-08-27",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "ADMIN_CONFIG",
      "id": "a25a0f05fe4b4bcdaa5045ce29f8379e"
    }
  ],
  // Usage analytics (Sep 10 2026, see worker.js's own comment near
  // ANALYTICS_HEARTBEAT_SECONDS) — anonymous session pings only (no IP, no
  // device info, no names), so the admin console can show which pieces get
  // played, for how long, at what speed, and what's muted. Provisioned
  // directly via the Cloudflare API, not `wrangler d1 create` — already
  // live on the account, this binding is what actually wires it into the
  // Worker (needs a real deploy to take effect, same as any other code
  // change here).
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "mosaic-analytics",
      "database_id": "b2b0b7ad-9d01-43b5-b76e-80158d204fc8"
    }
  ],

  // Staging build (Sep 12 2026) — a second, independent Worker for internal
  // testers, deployed with `npx wrangler deploy --env staging`. It lives at
  // its own URL (mosaic-player-staging.silenius.workers.dev) and never
  // touches the live one — the URL that's already out there only changes
  // when someone runs the plain `npx wrangler deploy` (no --env), same as
  // always.
  //
  // Deliberately has its OWN kv_namespaces entry rather than reusing the
  // production ADMIN_CONFIG id above: admin-console edits (play order,
  // notation images, per-piece offsets) write straight to KV, so sharing
  // the namespace would mean testing on staging could silently change what
  // real users see. One-time setup: create the namespace and paste its id in
  // below (`npx wrangler kv namespace create ADMIN_CONFIG_STAGING`) — done,
  // see the id already filled in. No ADMIN_PASSPHRASE secret needed for
  // staging (see the "vars.ENVIRONMENT" comment below for why) — just
  // `npx wrangler deploy --env staging` from here.
  //
  // No d1_databases entry here on purpose — worker.js already no-ops
  // gracefully when ANALYTICS_DB isn't bound (see its "DB not yet bound"
  // comments), so staging traffic never lands in the real usage analytics.
  //
  // vars.ENVIRONMENT="staging" (Sep 12 2026) — read by worker.js's
  // checkPassphrase(): staging skips the admin passphrase gate entirely (by
  // request — no ADMIN_PASSPHRASE secret needs setting for staging at all
  // now), so admin.html on the staging URL goes straight in with zero typing.
  // Safe specifically because staging has its own unlisted URL and its own
  // separate ADMIN_CONFIG_STAGING KV above — there is nothing on staging a
  // passphrase-less visitor could do to the live site. Production has no
  // ENVIRONMENT var (or any value other than "staging"), so its real
  // passphrase check is completely unaffected.
  "env": {
    "staging": {
      "name": "mosaic-player-staging",
      "assets": {
        "directory": "./",
        "not_found_handling": "404-page",
        "binding": "ASSETS"
      },
      "kv_namespaces": [
        {
          "binding": "ADMIN_CONFIG",
          "id": "ce2dcd64f14944c1906d1726e1ef6c07"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging"
      }
    }
  }
}
